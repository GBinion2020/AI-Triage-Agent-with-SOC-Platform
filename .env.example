# ===============================
# Core SIEM + Pipeline
# ===============================
ELASTIC_BASE_URL="https://your-elastic-url:9200"
ELASTIC_API_KEY="replace-with-elastic-api-key"
ELASTIC_VERIFY_TLS="true"
ELASTIC_CA_BUNDLE=""
ELASTIC_REQUEST_TIMEOUT="30"

# Pipeline architecture: orchestrated (recommended) or legacy
PIPELINE_ARCH="orchestrated"

# Orchestration guardrails
ORCH_MAX_WAVES="2"
ORCH_MAX_ACTIONS_PER_WAVE="5"
ORCH_MAX_PARALLEL_ACTIONS="4"

# ===============================
# LLM Configuration
# ===============================
# Provider: local | external
LLM_PROVIDER="external"
LLM_MAX_RETRIES="2"

# Local model mode (Ollama/OpenAI-compatible local endpoint)
LLM_MODEL="llama3.1:8b"
LOCAL_LLM_URL="http://localhost:11434/api/generate"
LOCAL_LLM_TIMEOUT="240"

# External model mode (OpenAI-compatible)
EXTERNAL_LLM_MODEL="gpt-5.2"
EXTERNAL_LLM_URL="https://api.openai.com/v1/chat/completions"
EXTERNAL_LLM_API_KEY="replace-with-external-llm-key"
EXTERNAL_LLM_TIMEOUT="120"

# ===============================
# Threat Intel + Enrichment
# ===============================
VT_API_KEY=""
BRAVE_SEARCH_API_KEY=""
SERPAPI_API_KEY=""
OSINT_ENABLE_DUCKDUCKGO="false"
OSINT_TRUSTED_DOMAINS_ONLY="true"

# Entra ID (Microsoft Graph app credentials)
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""

# RAG embedding model behavior
# Set false to fail closed when the embedding model cache is not already present.
RAG_ALLOW_MODEL_DOWNLOAD="true"

# ===============================
# Notifications
# ===============================
RE_SEND_KEY=""
NOTIFY_EMAIL="security-team@example.com"
FROM_EMAIL="onboarding@resend.dev"

# ===============================
# Feedback API + Jira Webhook
# ===============================
FEEDBACK_RECEIVER_HOST="0.0.0.0"
FEEDBACK_RECEIVER_PORT="8001"
FEEDBACK_API_KEY="replace-with-long-random-secret"

# Use one DB mode:
# 1) SQLite (default)
FEEDBACK_DB_PATH="feedback_api/feedback.db"
# 2) PostgreSQL URL (optional)
# FEEDBACK_DB_URL="postgresql://user:password@localhost:5432/soc_feedback"

# Jira custom field IDs
JIRA_CLOSE_NOTE_FIELD="customfield_10101"
JIRA_DETECTION_CLASSIFICATION_FIELD="customfield_10100"
JIRA_TRIAGE_VERDICT_FIELD="customfield_10099"

# Optional public URL when webhook is exposed via tunnel/reverse proxy
FEEDBACK_PUBLIC_BASE_URL="https://your-webhook-domain.example"

# Optional Cloudflare named tunnel settings
CF_TUNNEL_NAME="soc-feedback-webhook"
CF_TUNNEL_ID=""
CF_TUNNEL_CREDENTIALS_FILE=""
CF_TUNNEL_HOSTNAME="your-webhook-domain.example"
# JIRA_WEBHOOK_SECRET="optional-additional-signature-secret"

# ===============================
# SOC Case UI
# ===============================
SOC_UI_HOST="0.0.0.0"
SOC_UI_PORT="8088"
SOC_UI_DB_PATH="soc_case_ui/soc_ui.db"
SOC_UI_CASES_DIR="cases"

# Used by soc_case_ui/docker-compose.yml for container-to-host Elastic routing
SOC_UI_ELASTIC_BASE_URL="https://host.docker.internal:9200"

# Optional Jira sync from SOC UI when ticket transitions/updates
JIRA_SYNC_ENABLED="false"
JIRA_SYNC_REQUIRED="false"
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
JIRA_PROJECT_KEY="SOC"
JIRA_ISSUE_TYPE="Task"
