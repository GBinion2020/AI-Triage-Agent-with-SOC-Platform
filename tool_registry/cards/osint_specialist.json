{
  "name": "osint_specialist",
  "display_name": "OSINT Safe Search Specialist",
  "description": "Performs safe, API-based internet research for public indicators and returns vetted references from trusted sources.",
  "specialist": "osint_specialist",
  "enabled_by_default": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "indicators": {"type": "array", "items": {"type": "string"}},
      "context_hint": {"type": "string"},
      "max_results_per_indicator": {"type": "integer", "minimum": 1, "maximum": 5}
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["results", "summary"]
  },
  "guardrails": [
    "Skip internal/private IP addresses.",
    "Use safe-search settings and trusted-source filtering.",
    "Never download or execute remote content."
  ],
  "timeout_seconds": 45,
  "max_retries": 1,
  "cost_class": "medium"
}
