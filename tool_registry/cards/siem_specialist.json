{
  "name": "siem_specialist",
  "display_name": "SIEM Specialist",
  "description": "Runs bounded SIEM investigation loops using host/timeframe pivots, event filters, and evidence-driven query refinement.",
  "specialist": "siem_specialist",
  "enabled_by_default": true,
  "input_schema": {
    "type": "object",
    "required": ["host_name", "alert_timestamp"],
    "properties": {
      "host_name": {"type": "string"},
      "alert_timestamp": {"type": "string", "description": "ISO 8601 alert timestamp"},
      "focus": {"type": "array", "items": {"type": "string"}},
      "max_queries": {"type": "integer", "minimum": 1, "maximum": 6},
      "indicators": {"type": "array", "items": {"type": "string"}}
    }
  },
  "output_schema": {
    "type": "object",
    "required": ["query_log", "parsed_results", "summary"]
  },
  "guardrails": [
    "Use evidence-anchored filters only.",
    "Honor SIEM time-window limits and duplicate suppression.",
    "No unbounded wildcard queries."
  ],
  "timeout_seconds": 120,
  "max_retries": 1,
  "cost_class": "high"
}
